{
  "index_patterns": ["nexasphere-api-requests-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "nexasphere-api-requests-90d"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "event": { "type": "keyword" },
        "level": { "type": "keyword" },
        "message": { "type": "text" },
        "service": { "type": "keyword" },
        "reqId": { "type": "keyword" },
        "traceId": { "type": "keyword" },
        "method": { "type": "keyword" },
        "path": { "type": "keyword" },
        "status": { "type": "integer" },
        "responseTimeMs": { "type": "double" }
      }
    }
  },
  "priority": 150
}
